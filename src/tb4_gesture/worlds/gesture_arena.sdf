<?xml version="1.0"?>
<!-- Bai 06: arena 8 x 8 m trong, tuong thap bao quanh. Robot spawn tai (0, 0),
     dock dat o goc (-3, -3) de khong chan duong di. -->
<sdf version="1.6">
  <world name="gesture_arena">
    <scene>
      <grid>false</grid>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.85 0.9 1</background>
    </scene>
    <physics name="3ms" type="ignored">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"></plugin>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"></plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"></plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0 4.0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8.1 0.1 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8.1 0.1 0.4</size></box></geometry><material><ambient>0.75 0.45 0.2 1</ambient><diffuse>0.75 0.45 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -4.0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8.1 0.1 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8.1 0.1 0.4</size></box></geometry><material><ambient>0.75 0.45 0.2 1</ambient><diffuse>0.75 0.45 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>4.0 0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 8.1 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 8.1 0.4</size></box></geometry><material><ambient>0.75 0.45 0.2 1</ambient><diffuse>0.75 0.45 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-4.0 0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 8.1 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 8.1 0.4</size></box></geometry><material><ambient>0.75 0.45 0.2 1</ambient><diffuse>0.75 0.45 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="mark_x">
      <static>true</static>
      <pose>0.75 0 0.001 0 0 0</pose>
      <link name="link">
        
        <visual name="v"><geometry><box><size>1.5 0.03 0.002</size></box></geometry><material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="mark_y">
      <static>true</static>
      <pose>0 0.75 0.001 0 0 0</pose>
      <link name="link">
        
        <visual name="v"><geometry><box><size>0.03 1.5 0.002</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
